    <!-- Client-side Checkout & TxHash Lookup Logic -->
    <script is:inline>
      let currentTier = '';
      let currentAmount = 0;
      let currentPlanName = '';

      // --- 1. TxHash 序號查詢邏輯 ---
      async function lookupKeyByTx() {
        const inputEl = document.getElementById('portal-tx-input');
        const errorEl = document.getElementById('portal-lookup-error');
        const resultEl = document.getElementById('portal-lookup-result');
        const keyRenderEl = document.getElementById('portal-rendered-key');
        const tierRenderEl = document.getElementById('portal-key-tier');
        const btnEl = document.getElementById('portal-lookup-btn');

        if (!inputEl || !btnEl) return;

        const txValue = inputEl.value.trim();
        if (!txValue) {
          if (errorEl) {
            errorEl.innerText = "Please enter a valid TxHash or Order ID.";
            errorEl.classList.remove('hidden');
          }
          if (resultEl) resultEl.classList.add('hidden');
          inputEl.focus();
          return;
        }

        if (errorEl) errorEl.classList.add('hidden');
        if (resultEl) resultEl.classList.add('hidden');

        btnEl.disabled = true;
        btnEl.innerHTML = `<span class="animate-pulse">Searching...</span>`;

        try {
          const API_ENDPOINT = "https://api.gettradeguard.app/api/lookup-key";
          
          const res = await fetch(API_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ query: txValue })
          });

          const data = await res.json();

          if (data.success && data.license_key) {
            if (keyRenderEl) keyRenderEl.innerText = data.license_key;
            if (tierRenderEl) tierRenderEl.innerText = (data.tier || 'PRO').toUpperCase();
            if (resultEl) resultEl.classList.remove('hidden');
          } else {
            const errMsg = data.message || "No license key found for this TxHash or Order ID. Please make sure the transaction is confirmed on the blockchain.";
            if (errorEl) {
              errorEl.innerText = errMsg;
              errorEl.classList.remove('hidden');
            }
          }
        } catch (err) {
          if (errorEl) {
            errorEl.innerText = "Network connection error: " + err.message;
            errorEl.classList.remove('hidden');
          }
        } finally {
          btnEl.disabled = false;
          btnEl.innerHTML = `<span>Search Key</span> <span>🔍</span>`;
        }
      }

      async function copyPortalKey() {
        const keyEl = document.getElementById('portal-rendered-key');
        const btnEl = document.getElementById('portal-copy-btn');
        if (!keyEl) return;

        const keyText = keyEl.innerText.trim();
        try {
          await navigator.clipboard.writeText(keyText);
          if (btnEl) {
            btnEl.innerHTML = `<span>✓ Key Copied to Clipboard!</span>`;
            btnEl.classList.remove('bg-emerald-600', 'hover:bg-emerald-500');
            btnEl.classList.add('bg-sky-600');
            setTimeout(() => {
              btnEl.innerHTML = `<span>📋 Copy Key to Clipboard</span>`;
              btnEl.classList.remove('bg-sky-600');
              btnEl.classList.add('bg-emerald-600', 'hover:bg-emerald-500');
            }, 3000);
          }
        } catch (err) {
          alert("Key: " + keyText);
        }
      }

      // --- 2. 結帳 modal 與相關邏輯 ---
      function openCheckoutModal(tier, amount, planName) {
        currentTier = tier;
        currentAmount = amount;
        currentPlanName = planName;

        const planNameEl = document.getElementById('modal-plan-name');
        const planPriceEl = document.getElementById('modal-plan-price');
        const submitBtn = document.getElementById('modal-submit-btn');
        const gatewayEl = document.getElementById('modal-footer-gateway');
        const tipBoxEl = document.getElementById('crypto-tip-box');
        const subNoteEl = document.getElementById('modal-sub-note');

        if (planNameEl) planNameEl.innerText = planName;
        if (planPriceEl) planPriceEl.innerText = `$${amount}`;

        const errorEl = document.getElementById('modal-error');
        if (errorEl) {
          errorEl.classList.add('hidden');
          errorEl.innerText = '';
        }

        if (submitBtn) {
          submitBtn.disabled = false;
          if (amount === 0) {
            submitBtn.innerHTML = `<span>Claim 3-Day Free Trial</span> <span class="text-lg">🎉</span>`;
            if (gatewayEl) gatewayEl.innerText = `🎁 Zero Risk Trial`;
            if (tipBoxEl) tipBoxEl.classList.add('hidden');
            if (subNoteEl) {
              subNoteEl.innerHTML = `🔒 Your 3-Day Free Trial License Key will be sent to this email address. Limit 1 free trial per PC and email.`;
            }
          } else {
            submitBtn.innerHTML = `<span>Proceed to Crypto Payment</span> <span class="text-lg">🚀</span>`;
            if (gatewayEl) gatewayEl.innerText = `💳 Powered by NOWPayments`;
            if (tipBoxEl) tipBoxEl.classList.remove('hidden');
            if (subNoteEl) {
              subNoteEl.innerHTML = `🔒 Your License Key will be delivered instantly to this email address.`;
            }
          }
        }

        const modal = document.getElementById('checkout-modal');
        if (modal) modal.classList.remove('hidden');

        setTimeout(() => {
          const input = document.getElementById('modal-email-input');
          if (input) input.focus();
        }, 50);
      }

      function closeCheckoutModal() {
        const modal = document.getElementById('checkout-modal');
        if (modal) modal.classList.add('hidden');
      }

      function closeSuccessModal() {
        const modal = document.getElementById('payment-success-modal');
        if (modal) modal.classList.add('hidden');
        const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
        window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
      }

      async function copySuccessKey() {
        const keyEl = document.getElementById('success-rendered-key');
        const btnEl = document.getElementById('copy-key-btn');
        if (!keyEl) return;

        const keyText = keyEl.innerText.trim();
        try {
          await navigator.clipboard.writeText(keyText);
          if (btnEl) {
            btnEl.innerHTML = `<span>✓ Key Copied to Clipboard!</span>`;
            btnEl.classList.remove('bg-sky-500', 'hover:bg-sky-600');
            btnEl.classList.add('bg-emerald-600');
            setTimeout(() => {
              btnEl.innerHTML = `<span>📋 Copy License Key</span>`;
              btnEl.classList.remove('bg-emerald-600');
              btnEl.classList.add('bg-sky-500', 'hover:bg-sky-600');
            }, 3000);
          }
        } catch (err) {
          alert("Key: " + keyText);
        }
      }

      async function submitCheckout() {
        const inputEl = document.getElementById('modal-email-input');
        const errorEl = document.getElementById('modal-error');
        const submitBtn = document.getElementById('modal-submit-btn');

        if (!submitBtn || submitBtn.disabled) return;

        const emailTrimmed = inputEl ? inputEl.value.trim() : '';
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (!emailTrimmed) {
          if (errorEl) {
            errorEl.innerText = "Please enter your email address.";
            errorEl.classList.remove('hidden');
          }
          if (inputEl) inputEl.focus();
          return;
        }

        if (!emailRegex.test(emailTrimmed)) {
          if (errorEl) {
            errorEl.innerText = "Please enter a valid email address (e.g. name@domain.com).";
            errorEl.classList.remove('hidden');
          }
          if (inputEl) inputEl.focus();
          return;
        }

        if (errorEl) errorEl.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span class="animate-pulse">Processing...</span>`;

        try {
          const API_ENDPOINT = "https://api.gettradeguard.app/api/checkout";

          const response = await fetch(API_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              tier: currentTier,
              email: emailTrimmed
            })
          });

          const data = await response.json();

          if (data.success && data.invoice_url) {
            window.location.href = data.invoice_url;
          } else if (data.success && data.license_key) {
            closeCheckoutModal();
            showSuccessKeyModal(data.license_key);
          } else {
            const errMsg = data.message || (data.error && (data.error.message || JSON.stringify(data.error))) || "Failed to process request.";
            if (errorEl) {
              errorEl.innerText = "Checkout Error: " + errMsg;
              errorEl.classList.remove('hidden');
            }
            submitBtn.disabled = false;
            submitBtn.innerHTML = currentAmount === 0 
              ? `<span>Claim 3-Day Free Trial</span> <span class="text-lg">🎉</span>`
              : `<span>Proceed to Crypto Payment</span> <span class="text-lg">🚀</span>`;
          }
        } catch (err) {
          if (errorEl) {
            errorEl.innerText = "Network connection error: " + err.message;
            errorEl.classList.remove('hidden');
          }
          submitBtn.disabled = false;
          submitBtn.innerHTML = currentAmount === 0 
            ? `<span>Claim 3-Day Free Trial</span> <span class="text-lg">🎉</span>`
            : `<span>Proceed to Crypto Payment</span> <span class="text-lg">🚀</span>`;
        }
      }

      function showSuccessKeyModal(licenseKey) {
        const modal = document.getElementById('payment-success-modal');
        const loadingEl = document.getElementById('key-loading-state');
        const displayEl = document.getElementById('key-display-state');
        const keyEl = document.getElementById('success-rendered-key');

        if (keyEl) keyEl.innerText = licenseKey;
        if (loadingEl) loadingEl.classList.add('hidden');
        if (displayEl) displayEl.classList.remove('hidden');
        if (modal) modal.classList.remove('hidden');
      }

      async function checkPaymentSuccessOnLoad() {
        const urlParams = new URLSearchParams(window.location.search);
        const billingStatus = urlParams.get('billing');
        const orderId = urlParams.get('order_id') || urlParams.get('order');

        if (billingStatus === 'success') {
          const modal = document.getElementById('payment-success-modal');
          const loadingEl = document.getElementById('key-loading-state');
          const displayEl = document.getElementById('key-display-state');
          const keyEl = document.getElementById('success-rendered-key');

          if (modal) modal.classList.remove('hidden');
          if (loadingEl) loadingEl.classList.remove('hidden');
          if (displayEl) displayEl.classList.add('hidden');

          let pollAttempts = 0;
          const maxAttempts = 12;

          const pollInterval = setInterval(async () => {
            pollAttempts++;
            try {
              const API_STATUS_ENDPOINT = `https://api.gettradeguard.app/api/order-status?order_id=${encodeURIComponent(orderId || '')}`;
              const res = await fetch(API_STATUS_ENDPOINT);
              const resData = await res.json();

              if (resData.success && resData.license_key) {
                clearInterval(pollInterval);
                if (keyEl) keyEl.innerText = resData.license_key;
                if (loadingEl) loadingEl.classList.add('hidden');
                if (displayEl) displayEl.classList.remove('hidden');
              }
            } catch (err) {
              console.warn("Polling error:", err);
            }

            if (pollAttempts >= maxAttempts) {
              clearInterval(pollInterval);
              if (loadingEl) {
                loadingEl.innerHTML = `
                  <p class="text-xs text-amber-400">Transaction is still confirming on the blockchain.</p>
                  <p class="text-[11px] text-slate-400">Please check your email or retrieve your key via User Portal in a few minutes.</p>
                `;
              }
            }
          }, 3000);
        }
      }

      window.addEventListener('DOMContentLoaded', () => {
        checkPaymentSuccessOnLoad();

        const emailInput = document.getElementById('modal-email-input');
        emailInput?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            submitCheckout();
          }
        });

        const txInput = document.getElementById('portal-tx-input');
        txInput?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            lookupKeyByTx();
          }
        });
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeCheckoutModal();
          closeSuccessModal();
        }
      });

      document.getElementById('checkout-modal')?.addEventListener('click', (e) => {
        if (e.target.id === 'checkout-modal') closeCheckoutModal();
      });

      document.getElementById('payment-success-modal')?.addEventListener('click', (e) => {
        if (e.target.id === 'payment-success-modal') closeSuccessModal();
      });

      window.openCheckoutModal = openCheckoutModal;
      window.closeCheckoutModal = closeCheckoutModal;
      window.closeSuccessModal = closeSuccessModal;
      window.copySuccessKey = copySuccessKey;
      window.submitCheckout = submitCheckout;
      window.lookupKeyByTx = lookupKeyByTx;
      window.copyPortalKey = copyPortalKey;
    </script>

  </body>
</html>