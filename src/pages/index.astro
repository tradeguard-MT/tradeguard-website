---
// src/pages/index.astro
import '../styles/global.css';
---
<html lang="en" class="scroll-smooth scroll-pt-20">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TradeGuard - Automated Risk Enforcement for Binary Options Traders</title>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen font-sans selection:bg-sky-500 selection:text-white">
    
    <!-- 1. Navigation Menu (Sticky Header with Backdrop Blur) -->
    <nav class="sticky top-0 z-40 w-full bg-slate-900/80 backdrop-blur-md border-b border-slate-800">
      <div class="flex justify-between items-center px-6 py-4 max-w-6xl mx-auto">
        <!-- 點擊 Logo 平滑回到 Hero Section (頁面頂部) -->
        <a href="#" class="text-xl font-bold text-sky-400 flex items-center gap-2 hover:opacity-90 transition cursor-pointer" aria-label="TradeGuard Home">
          <span>🛡️</span> TradeGuard <span class="text-xs bg-sky-950 text-sky-400 px-2 py-0.5 rounded border border-sky-800">PRO</span>
        </a>
        <div class="hidden md:flex space-x-6 text-sm">
          <a href="#who-is-it-for" class="hover:text-sky-400 transition">Who It's For</a>
          <a href="#how-it-works" class="hover:text-sky-400 transition">How It Works</a>
          <a href="#features" class="hover:text-sky-400 transition">Dual-Engine</a>
          <a href="#download" class="hover:text-sky-400 transition">Download</a>
          <a href="#pricing" class="hover:text-sky-400 transition">Pricing</a>
          <a href="#portal" class="hover:text-sky-400 transition">Key Lookup</a>
          <a href="#faq" class="hover:text-sky-400 transition">FAQ</a>
        </div>
        <a href="#pricing" class="bg-sky-500 hover:bg-sky-600 text-white text-sm font-bold px-4 py-2 rounded-lg transition">
          Get License
        </a>
      </div>
    </nav>

    <!-- 2. Hero Section (明確強調 Binary Options 適用) -->
    <section class="py-20 text-center max-w-4xl mx-auto px-4">
      <div class="inline-block bg-slate-800 text-sky-400 text-xs px-3 py-1 rounded-full border border-slate-700 mb-6">
        🎯 Hardened Risk Enforcement for Binary Options Traders
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-tight">
        Eliminate Emotional Trading.<br/><span class="text-sky-400">Automated Discipline for Binary Options.</span>
      </h1>
      <p class="text-slate-400 text-lg mb-8 max-w-2xl mx-auto">
        TradeGuard combines a lightweight browser extension with a Windows Enforcement Agent to strictly lock your binary options trading accounts (Pocket Option, Quotex) when your stop-loss or profit target is hit.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="#download" class="bg-sky-500 hover:bg-sky-600 text-white px-8 py-4 rounded-lg font-bold text-lg shadow-lg transition flex items-center justify-center gap-2">
          <span>⬇️ Download App</span>
        </a>
        <a href="#pricing" class="bg-red-600 hover:bg-red-700 text-white px-8 py-4 rounded-lg font-bold text-lg shadow-lg transition">
          🔒 Lock Your Discipline
        </a>
      </div>
      <!-- Badges -->
      <div class="flex flex-wrap justify-center items-center gap-6 mt-12 text-xs text-slate-500">
        <span>📈 Pocket Option & Quotex Support</span>
        <span>⚡ MV3 WebSocket Interceptor</span>
        <span>🛡️ Automated Policy Deployment</span>
        <span>🐕 Active Process Watchdog</span>
      </div>
    </section>

    <!-- 2.5 Who It's For Section -->
    <section id="who-is-it-for" class="relative py-24 border-t border-slate-800 overflow-hidden bg-slate-950">
      
      <!-- 1. K-Line Candlestick Background Layer -->
      <div 
        class="absolute inset-0 z-0 bg-cover bg-center pointer-events-none"
        style="background-image: url('/screenshots/kline-bg.webp'); opacity: 0.5;"
      ></div>
      
      <!-- 2. Smooth Dark Gradient Overlay -->
      <div class="absolute inset-0 z-0 bg-gradient-to-b from-slate-950/70 via-slate-900/30 to-slate-950/80 pointer-events-none"></div>

      <!-- 3. Forefront Content Wrapper -->
      <div class="relative z-10 max-w-6xl mx-auto px-4">
        <div class="text-center mb-16">
          <div class="inline-block bg-sky-950 text-sky-400 text-xs px-3 py-1 rounded-full border border-sky-800 mb-3">
            🎯 Target Traders
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">Designed for Binary Traders Fighting Emotional Discipline</h2>
          <p class="text-slate-400 max-w-2xl mx-auto text-sm md:text-base">
            If any of these sound familiar, TradeGuard was built specifically to protect your binary options trading capital.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Card 1 -->
          <div class="bg-slate-900/90 backdrop-blur-sm p-6 rounded-2xl border border-slate-800 hover:border-sky-500/50 transition duration-200 shadow-xl">
            <div class="inline-block bg-red-950/80 text-red-400 text-[11px] font-bold px-2.5 py-1 rounded-md border border-red-800/80 mb-4">
              🚨 Stop Revenge Trading
            </div>
            <h3 class="text-xl font-bold text-white mb-2">The Revenge Trader</h3>
            <p class="text-slate-400 text-xs md:text-sm leading-relaxed">
              You experience a loss and instantly size up or overtrade to "get it back," burning through weeks of profits in minutes.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="bg-slate-900/90 backdrop-blur-sm p-6 rounded-2xl border border-slate-800 hover:border-sky-500/50 transition duration-200 shadow-xl">
            <div class="inline-block bg-amber-950/80 text-amber-400 text-[11px] font-bold px-2.5 py-1 rounded-md border border-amber-800/80 mb-4">
              🛑 Enforce Hard Stop-Loss
            </div>
            <h3 class="text-xl font-bold text-white mb-2">The Plan Breaker</h3>
            <p class="text-slate-400 text-xs md:text-sm leading-relaxed">
              You set strict daily stop-loss rules on paper, but manually ignore or bypass them mid-session during emotional tilt.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="bg-slate-900/90 backdrop-blur-sm p-6 rounded-2xl border border-slate-800 hover:border-sky-500/50 transition duration-200 shadow-xl">
            <div class="inline-block bg-emerald-950/80 text-emerald-400 text-[11px] font-bold px-2.5 py-1 rounded-md border border-emerald-800/80 mb-4">
              🎯 Lock In Daily Profits
            </div>
            <h3 class="text-xl font-bold text-white mb-2">The Overtrader</h3>
            <p class="text-slate-400 text-xs md:text-sm leading-relaxed">
              You hit your profit target for the day, but FOMO keeps you trading until all your hard-earned gains turn into losses.
            </p>
          </div>

          <!-- Card 4 -->
          <div class="bg-slate-900/90 backdrop-blur-sm p-6 rounded-2xl border border-slate-800 hover:border-sky-500/50 transition duration-200 shadow-xl">
            <div class="inline-block bg-sky-950/80 text-sky-400 text-[11px] font-bold px-2.5 py-1 rounded-md border border-sky-800/80 mb-4">
              🛡️ 100% Automated Guard
            </div>
            <h3 class="text-xl font-bold text-white mb-2">The Consistency Seeker</h3>
            <p class="text-slate-400 text-xs md:text-sm leading-relaxed">
              You want an un-bypassable system layer to force 100% compliance with your risk strategy across supported broker interfaces.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2.6 How It Works Section (帶有截圖框架卡片) -->
    <section id="how-it-works" class="py-20 bg-slate-900 border-t border-slate-800">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16">
          <div class="inline-block bg-sky-950 text-sky-400 text-xs px-3 py-1 rounded-full border border-sky-800 mb-3">
            ⚡ 60-Second Setup • Hardened Enforcement
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">Automated Protection in 3 Simple Steps</h2>
          <p class="text-slate-400 max-w-2xl mx-auto text-sm md:text-base">
            Simple to configure, effortless to run, but strictly hardened against impulsive bypass.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          
          <!-- Step 1 Card -->
          <div class="bg-slate-800/80 rounded-2xl border border-slate-700 overflow-hidden flex flex-col shadow-xl">
            <!-- Window Mockup Header -->
            <div class="bg-slate-950 px-4 py-3 border-b border-slate-800 flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-500/80 inline-block"></span>
              </div>
              <span class="text-[11px] font-mono text-slate-500">Step 1 • Desktop Agent</span>
            </div>
            <!-- Image Container -->
            <div class="bg-slate-950/60 p-2 border-b border-slate-800/60">
              <img 
                src="/screenshots/step1-gui.png" 
                alt="TradeGuard GUI Configuration Screenshot" 
                class="rounded-lg border border-slate-800 w-full h-44 object-cover object-top bg-slate-900 text-xs text-slate-600 flex items-center justify-center"
                onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'h-44 bg-slate-900/80 rounded-lg border border-slate-800 flex flex-col items-center justify-center p-4 text-center\'><span class=\'text-3xl mb-1\'>🖥️</span><span class=\'text-xs text-sky-400 font-bold\'>TradeGuard GUI Dashboard</span><span class=\'text-[10px] text-slate-500 mt-1\'>Set SL / TP & Lock Duration</span></div>';"
              />
            </div>
            <!-- Content -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
              <div>
                <div class="text-xs font-bold text-sky-400 mb-1">01. FAST CONFIGURATION</div>
                <h3 class="text-lg font-bold text-white mb-2">Set Your Risk Limits</h3>
                <p class="text-slate-400 text-xs leading-relaxed">
                  Launch <code class="text-slate-200">TradeGuard.exe</code> on Windows and configure your Daily Stop-Loss, Take-Profit target, or manual lock duration in seconds.
                </p>
              </div>
            </div>
          </div>

          <!-- Step 2 Card -->
          <div class="bg-slate-800/80 rounded-2xl border border-slate-700 overflow-hidden flex flex-col shadow-xl">
            <!-- Window Mockup Header -->
            <div class="bg-slate-950 px-4 py-3 border-b border-slate-800 flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-500/80 inline-block"></span>
              </div>
              <span class="text-[11px] font-mono text-slate-500">Step 2 • Browser HUD</span>
            </div>
            <!-- Image Container -->
            <div class="bg-slate-950/60 p-2 border-b border-slate-800/60">
              <img 
                src="/screenshots/step2-hud.png" 
                alt="Browser HUD Overlay Screenshot" 
                class="rounded-lg border border-slate-800 w-full h-44 object-cover object-top bg-slate-900 text-xs text-slate-600 flex items-center justify-center"
                onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'h-44 bg-slate-900/80 rounded-lg border border-slate-800 flex flex-col items-center justify-center p-4 text-center\'><span class=\'text-3xl mb-1\'>🌐</span><span class=\'text-xs text-sky-400 font-bold\'>Real-Time Health Bar (HP) HUD</span><span class=\'text-[10px] text-slate-500 mt-1\'>Taps Trade Packets on Browser</span></div>';"
              />
            </div>
            <!-- Content -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
              <div>
                <div class="text-xs font-bold text-sky-400 mb-1">02. SEAMLESS MONITORING</div>
                <h3 class="text-lg font-bold text-white mb-2">Trade as Usual with Live HUD</h3>
                <p class="text-slate-400 text-xs leading-relaxed">
                  Open your preferred browser (Chrome, Edge, Brave, or Firefox) and trade. Our Extension sensor taps trade execution packets and overlays a live Health Bar HUD on your screen.
                </p>
              </div>
            </div>
          </div>

          <!-- Step 3 Card -->
          <div class="bg-slate-800/80 rounded-2xl border border-slate-700 overflow-hidden flex flex-col shadow-xl">
            <!-- Window Mockup Header -->
            <div class="bg-slate-950 px-4 py-3 border-b border-slate-800 flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-500/80 inline-block"></span>
              </div>
              <span class="text-[11px] font-mono text-slate-500">Step 3 • Lockout Shield</span>
            </div>
            <!-- Image Container -->
            <div class="bg-slate-950/60 p-2 border-b border-slate-800/60">
              <img 
                src="/screenshots/step3-lock.png" 
                alt="Enforced Lockout Screen Screenshot" 
                class="rounded-lg border border-slate-800 w-full h-44 object-cover object-top bg-slate-900 text-xs text-slate-600 flex items-center justify-center"
                onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'h-44 bg-slate-900/80 rounded-lg border border-slate-800 flex flex-col items-center justify-center p-4 text-center\'><span class=\'text-3xl mb-1\'>🔒</span><span class=\'text-xs text-red-400 font-bold\'>Hardened System Lockout</span><span class=\'text-[10px] text-slate-500 mt-1\'>No Overrides Until Timer Expires</span></div>';"
              />
            </div>
            <!-- Content -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
              <div>
                <div class="text-xs font-bold text-red-400 mb-1">03. HARDENED LOCKOUT</div>
                <h3 class="text-lg font-bold text-white mb-2">Instant Enforced Lockout</h3>
                <p class="text-slate-400 text-xs leading-relaxed">
                  The moment a risk limit is hit, TradeGuard’s Windows Enforcer immediately locks access to the binary trading interface. Zero impulsive overrides—protecting your capital until countdown expires.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 3. Dual-Engine Architecture & Features Section -->
    <section id="features" class="py-16 bg-slate-800/40 border-t border-slate-800">
      <div id="architecture" class="max-w-5xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-4">Dual-Engine Anti-Tilt Architecture</h2>
        <p class="text-slate-400 text-center mb-12 max-w-2xl mx-auto">Operating at both the browser DOM layer and Windows system level to enforce real-time discipline.</p>
        
        <div class="grid md:grid-cols-2 gap-8">
          <!-- Engine 1 -->
          <div class="bg-slate-800 p-8 rounded-xl border border-slate-700">
            <div class="text-sky-400 text-sm font-bold uppercase tracking-wider mb-2">Frontend Sensor</div>
            <h3 class="text-2xl font-bold mb-4 flex items-center gap-2">
              <span>🌐</span> Browser Extension (MV3)
            </h3>
            <ul class="space-y-3 text-slate-300 text-sm">
              <li class="flex items-start gap-2">
                <span class="text-sky-400">✓</span>
                <span><strong>Automated Policy Deployment:</strong> Installed automatically via Windows Policy during setup—no manual store search or pairing needed.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400">✓</span>
                <span><strong>Real-Time Packet Tapping:</strong> Intercepts raw WebSocket & HTTP trade execution packets directly in browser memory.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400">✓</span>
                <span><strong>Live HUD Overlay:</strong> Displays real-time Health Bar (HP) widgets and account metrics right on your chart screen.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400">✓</span>
                <span><strong>Policy-Managed Guard:</strong> Enforced via Windows Group Policy to resist accidental removal or incognito bypass during tilt.</span>
              </li>
            </ul>
          </div>

          <!-- Engine 2 -->
          <div class="bg-slate-800 p-8 rounded-xl border border-slate-700">
            <div class="text-red-400 text-sm font-bold uppercase tracking-wider mb-2">Backend Enforcer</div>
            <h3 class="text-2xl font-bold mb-4 flex items-center gap-2">
              <span>🖥️</span> Windows Desktop Agent
            </h3>
            <ul class="space-y-3 text-slate-300 text-sm">
              <li class="flex items-start gap-2">
                <span class="text-red-400">✓</span>
                <span><strong>Local IPC Server:</strong> Communicates via encrypted 127.0.0.1 WebSocket with zero external proxy overhead.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-400">✓</span>
                <span><strong>Resilient Background Watchdog:</strong> Active process monitor designed to resist impulsive termination during revenge trading.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-400">✓</span>
                <span><strong>Enforced Lockout Countdown:</strong> Automated lockouts trigger immediately upon reaching stop-loss or trade limits.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Download Section -->
    <section id="download" class="py-16 bg-slate-900 border-t border-slate-800">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <div class="inline-block bg-sky-950 text-sky-400 text-xs px-3 py-1 rounded-full border border-sky-800 mb-4">
          ⬇️ Official Download
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">Get TradeGuard for Windows</h2>
        <p class="text-slate-400 mb-8 max-w-xl mx-auto text-sm md:text-base">
          Download the latest installation package. Single-installer setup automatically configures desktop enforcer & browser extensions.
        </p>

        <div class="bg-slate-800/80 p-8 rounded-2xl border border-slate-700 max-w-2xl mx-auto shadow-xl">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="text-left">
              <div class="text-lg font-bold text-white flex items-center gap-2">
                <span>💻</span> TradeGuard_Setup_v1.1.0.exe
              </div>
              <div class="text-xs text-slate-400 mt-1 space-y-0.5">
                <p>Version: <span class="text-sky-400 font-semibold">1.1.0 (Stable)</span></p>
                <p>OS Support: Windows 10 / 11 (64-bit)</p>
              </div>
            </div>
            <a 
              href="https://dl.gettradeguard.app/TradeGuard_Setup_v1.1.0.exe" 
              class="bg-sky-500 hover:bg-sky-600 active:scale-95 text-white font-bold px-6 py-3.5 rounded-xl shadow-lg transition duration-150 flex items-center gap-2 whitespace-nowrap cursor-pointer"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Download Installer</span>
              <span class="text-lg">⬇️</span>
            </a>
          </div>

          <!-- Quick Setup Steps -->
          <div class="mt-6 pt-6 border-t border-slate-700/80 grid sm:grid-cols-3 gap-4 text-xs text-slate-400 text-left">
            <div>
              <span class="text-sky-400 font-bold block mb-0.5">1. Download & Run</span>
              Run <code class="text-slate-200">TradeGuard_Setup.exe</code> on your Windows PC.
            </div>
            <div>
              <span class="text-sky-400 font-bold block mb-0.5">2. Automated Setup</span>
              The installer automatically registers browser policies & extension—zero manual setup!
            </div>
            <div>
              <span class="text-sky-400 font-bold block mb-0.5">3. Activate Key</span>
              Claim your 3-Day Free Trial key below to start protecting your account.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Pricing Section -->
    <section id="pricing" class="py-20 border-t border-slate-800">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-10">
          <h2 class="text-3xl md:text-4xl font-extrabold mb-4">Protect Your Binary Trading Capital</h2>
          <p class="text-slate-400">One emotional trade can cost hundreds. Invest in automated discipline.</p>
        </div>

        <!-- Clarity Guarantee Banner -->
        <div class="bg-slate-800/90 border border-sky-500/40 rounded-xl p-4 mb-12 max-w-4xl mx-auto text-center text-xs md:text-sm text-sky-200 flex flex-wrap justify-center items-center gap-4 md:gap-8 shadow-lg">
          <span class="flex items-center gap-1.5 font-semibold text-white">
            <strong class="text-sky-400 text-base">⏳</strong> Starts Only Upon Activation <span class="text-slate-400 text-xs">(Zero Wasted Time)</span>
          </span>
          <span class="flex items-center gap-1.5"><strong class="text-sky-400">✓</strong> One-Time Payment</span>
          <span class="flex items-center gap-1.5"><strong class="text-sky-400">✓</strong> No Auto-Recurring Billing</span>
          <span class="flex items-center gap-1.5"><strong class="text-sky-400">✓</strong> Duration Stacks on Renewal</span>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- 1. 3-Day Free Trial -->
          <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700 flex flex-col justify-between">
            <div>
              <div class="inline-block bg-slate-700 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wide mb-3">
                1 Free per PC
              </div>
              <h3 class="text-lg font-bold mb-1">3-Day Free Trial</h3>
              <p class="text-slate-400 text-xs mb-4">Test full risk enforcement on your PC with zero obligation.</p>
              <div class="text-3xl font-extrabold mb-6 text-white">$0</div>
              <ul class="space-y-2.5 text-xs text-slate-300 mb-8">
                <li>✓ Full Dual-Engine Protection</li>
                <li>✓ Automated TP & SL Risk Control</li>
                <li>✓ Pocket Option & Quotex Support</li>
              </ul>
            </div>
            <button 
              onclick="openCheckoutModal('trial', 0, '3-Day Free Trial')"
              class="w-full bg-slate-700 hover:bg-slate-600 active:scale-95 text-white text-center font-bold py-3 rounded-lg text-sm transition duration-150 block cursor-pointer">
              Claim Free Trial
            </button>
          </div>

          <!-- 2. 7-Day Pass -->
          <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700 flex flex-col justify-between">
            <div>
              <div class="inline-block bg-amber-950/80 text-amber-400 text-[10px] font-bold px-2 py-0.5 rounded border border-amber-800 uppercase tracking-wide mb-3">
                Event Sprint
              </div>
              <h3 class="text-lg font-bold mb-1">7-Day Pass</h3>
              <p class="text-slate-400 text-xs mb-4">Ideal for high-volatility news weeks (NFP / CPI).</p>
              <div class="text-3xl font-extrabold mb-6 text-white">$7 <span class="text-xs font-normal text-slate-400">/ 7 days</span></div>
              <ul class="space-y-2.5 text-xs text-slate-300 mb-8">
                <li>✓ Full Dual-Engine Protection</li>
                <li>✓ Automated TP & SL Risk Control</li>
