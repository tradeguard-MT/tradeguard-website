    <!-- ==================== 12. Client-Side JavaScript Logic ==================== -->
    <script is:inline>
      const API_BASE = "https://api.gettradeguard.app";
      let currentTier = '';
      let currentAmount = 0;
      let currentPlanName = '';

      function openCheckoutModal(tier, amount, planName) {
        currentTier = tier;
        currentAmount = amount;
        currentPlanName = planName;

        document.getElementById('modal-plan-name').innerText = planName;
        document.getElementById('modal-plan-price').innerText = `$${amount}`;

        // Reset states
        const emailInput = document.getElementById('modal-email-input');
        emailInput.value = '';
        emailInput.disabled = false;

        document.getElementById('modal-otp-input').value = '';
        document.getElementById('checkout-otp-step').classList.add('hidden');

        const btnSend = document.getElementById('btn-send-otp');
        btnSend.disabled = false;
        btnSend.innerText = "Send Code";

        document.getElementById('modal-email-error').classList.add('hidden');
        document.getElementById('modal-email-success').classList.add('hidden');
        document.getElementById('modal-otp-error').classList.add('hidden');

        const submitBtn = document.getElementById('modal-submit-btn');
        submitBtn.disabled = false;

        if (amount === 0) {
          submitBtn.innerHTML = `<span>Verify & Claim Free Trial</span> <span class="text-lg">🎉</span>`;
          document.getElementById('modal-footer-gateway').innerText = `🎁 Zero Risk Trial`;
          document.getElementById('crypto-tip-box').classList.add('hidden');
        } else {
          submitBtn.innerHTML = `<span>Verify & Proceed to Payment</span> <span class="text-lg">🚀</span>`;
          document.getElementById('modal-footer-gateway').innerText = `💳 Powered by NOWPayments`;
          document.getElementById('crypto-tip-box').classList.remove('hidden');
        }

        document.getElementById('checkout-modal').classList.remove('hidden');
        setTimeout(() => emailInput.focus(), 50);
      }

      function closeCheckoutModal() {
        document.getElementById('checkout-modal').classList.add('hidden');
      }

      function closeSuccessModal() {
        document.getElementById('payment-success-modal').classList.add('hidden');
        const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
        window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
      }

      async function sendOtpCode() {
        const emailInput = document.getElementById('modal-email-input');
        const errorEl = document.getElementById('modal-email-error');
        const successEl = document.getElementById('modal-email-success');
        const btn = document.getElementById('btn-send-otp');
        const otpStep = document.getElementById('checkout-otp-step');

        const email = emailInput.value.trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        errorEl.classList.add('hidden');
        successEl.classList.add('hidden');

        if (!email || !emailRegex.test(email)) {
          errorEl.innerText = "Please enter a valid email address.";
          errorEl.classList.remove('hidden');
          return;
        }

        btn.disabled = true;
        btn.innerHTML = `<span class="animate-pulse">Sending...</span>`;

        try {
          const res = await fetch(`${API_BASE}/api/email/send-code`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email })
          });
          const data = await res.json();

          if (data.success) {
            successEl.classList.remove('hidden');
            otpStep.classList.remove('hidden');
            emailInput.disabled = true;
            btn.innerText = "Sent ✓";
            document.getElementById('modal-otp-input').focus();
          } else {
            errorEl.innerText = data.message || "Failed to send verification code.";
            errorEl.classList.remove('hidden');
            btn.disabled = false;
            btn.innerText = "Send Code";
          }
        } catch (err) {
          errorEl.innerText = "Network connection error.";
          errorEl.classList.remove('hidden');
          btn.disabled = false;
          btn.innerText = "Send Code";
        }
      }

      async function verifyOtpAndCheckout() {
        const email = document.getElementById('modal-email-input').value.trim();
        const code = document.getElementById('modal-otp-input').value.trim();
        const errorEl = document.getElementById('modal-otp-error');
        const submitBtn = document.getElementById('modal-submit-btn');

        errorEl.classList.add('hidden');

        if (!code || code.length < 6) {
          errorEl.innerText = "Please enter the complete 6-digit code.";
          errorEl.classList.remove('hidden');
          return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span class="animate-pulse">Verifying...</span>`;

        try {
          // 1. Verify OTP & get session token
          const verifyRes = await fetch(`${API_BASE}/api/email/verify-code`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, code })
          });
          const verifyData = await verifyRes.json();

          if (!verifyData.success || !verifyData.token) {
            errorEl.innerText = verifyData.message || "Invalid verification code.";
            errorEl.classList.remove('hidden');
            resetSubmitBtn();
            return;
          }

          const sessionToken = verifyData.token;
          sessionStorage.setItem('tg_checkout_session', sessionToken);

          // 2. Automatically Proceed to Checkout using the authenticated session
          submitBtn.innerHTML = `<span class="animate-pulse">Creating Order...</span>`;

          const checkoutRes = await fetch(`${API_BASE}/api/checkout`, {
            method: "POST",
            headers: { 
              "Content-Type": "application/json",
              "Authorization": `Bearer ${sessionToken}` 
            },
            body: JSON.stringify({ tier: currentTier })
          });
          const checkoutData = await checkoutRes.json();

          if (checkoutData.success && checkoutData.invoice_url) {
            window.location.href = checkoutData.invoice_url;
          } else if (checkoutData.success && checkoutData.license_key) {
            closeCheckoutModal();
            showSuccessKeyModal(checkoutData.license_key);
          } else {
            errorEl.innerText = "Checkout Error: " + (checkoutData.message || "Failed to process request.");
            errorEl.classList.remove('hidden');
            resetSubmitBtn();
          }
        } catch (err) {
          errorEl.innerText = "Network error: " + err.message;
          errorEl.classList.remove('hidden');
          resetSubmitBtn();
        }
      }

      function resetSubmitBtn() {
        const submitBtn = document.getElementById('modal-submit-btn');
        submitBtn.disabled = false;
        submitBtn.innerHTML = currentAmount === 0 
          ? `<span>Verify & Claim Free Trial</span> <span class="text-lg">🎉</span>`
          : `<span>Verify & Proceed to Payment</span> <span class="text-lg">🚀</span>`;
      }

      function showSuccessKeyModal(licenseKey) {
        const modal = document.getElementById('payment-success-modal');
        const loadingEl = document.getElementById('key-loading-state');
        const displayEl = document.getElementById('key-display-state');
        const keyEl = document.getElementById('success-rendered-key');

        if (keyEl) keyEl.innerText = licenseKey;
        if (loadingEl) loadingEl.classList.add('hidden');
        if (displayEl) displayEl.classList.remove('hidden');
        if (modal) modal.classList.remove('hidden');
      }

      async function copySuccessKey() {
        const keyEl = document.getElementById('success-rendered-key');
        const btnEl = document.getElementById('copy-key-btn');
        if (!keyEl) return;

        try {
          await navigator.clipboard.writeText(keyEl.innerText.trim());
          btnEl.innerHTML = `<span>✓ Key Copied to Clipboard!</span>`;
          btnEl.classList.replace('bg-sky-500', 'bg-emerald-600');
          btnEl.classList.remove('hover:bg-sky-600');
          setTimeout(() => {
            btnEl.innerHTML = `<span>📋 Copy License Key</span>`;
            btnEl.classList.replace('bg-emerald-600', 'bg-sky-500');
            btnEl.classList.add('hover:bg-sky-600');
          }, 3000);
        } catch (err) {
          alert("Key: " + keyEl.innerText.trim());
        }
      }

      async function checkPaymentSuccessOnLoad() {
        const urlParams = new URLSearchParams(window.location.search);
        const billingStatus = urlParams.get('billing');
        const orderId = urlParams.get('order_id') || urlParams.get('order');

        if (billingStatus === 'success') {
          document.getElementById('payment-success-modal').classList.remove('hidden');
          const loadingEl = document.getElementById('key-loading-state');
          const displayEl = document.getElementById('key-display-state');
          const keyEl = document.getElementById('success-rendered-key');

          const sessionToken = sessionStorage.getItem('tg_checkout_session') || "";

          let pollAttempts = 0;
          const maxAttempts = 12;

          const pollInterval = setInterval(async () => {
            pollAttempts++;
            try {
              const res = await fetch(`${API_BASE}/api/order-status?order_id=${encodeURIComponent(orderId || '')}`, {
                headers: { "Authorization": `Bearer ${sessionToken}` }
              });
              const resData = await res.json();

              if (resData.success) {
                if (resData.payment_status === "completed") {
                  clearInterval(pollInterval);
                  if (resData.license_key) {
                    keyEl.innerText = resData.license_key;
                    loadingEl.classList.add('hidden');
                    displayEl.classList.remove('hidden');
                  } else {
                    loadingEl.innerHTML = `
                      <div class="text-emerald-400 font-bold mb-2 text-lg">✓ Payment Completed</div>
                      <p class="text-sm text-slate-300">Your license key has been securely delivered to your email.</p>
                      <p class="text-[11px] text-slate-500 mt-3 border-t border-slate-800 pt-2">For security reasons, keys are only displayed within the original verified session.</p>
                    `;
                  }
                }
              }
            } catch (err) {
              console.warn("Polling error:", err);
            }

            if (pollAttempts >= maxAttempts) {
              clearInterval(pollInterval);
              loadingEl.innerHTML = `
                <p class="text-xs text-amber-400">Transaction is still confirming on the blockchain.</p>
                <p class="text-[11px] text-slate-400 mt-1">Please check your email inbox for your license key in a few minutes.</p>
              `;
            }
          }, 3000);
        }
      }

      window.addEventListener('DOMContentLoaded', () => {
        checkPaymentSuccessOnLoad();

        document.getElementById('modal-email-input')?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            sendOtpCode();
          }
        });

        document.getElementById('modal-otp-input')?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            verifyOtpAndCheckout();
          }
        });
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeCheckoutModal();
          closeSuccessModal();
        }
      });

      document.getElementById('checkout-modal')?.addEventListener('click', (e) => {
        if (e.target.id === 'checkout-modal') {
          closeCheckoutModal();
        }
      });

      document.getElementById('payment-success-modal')?.addEventListener('click', (e) => {
        if (e.target.id === 'payment-success-modal') {
          closeSuccessModal();
        }
      });

      // Expose to window for inline HTML onclicks
      window.openCheckoutModal = openCheckoutModal;
      window.closeCheckoutModal = closeCheckoutModal;
      window.closeSuccessModal = closeSuccessModal;
      window.copySuccessKey = copySuccessKey;
      window.sendOtpCode = sendOtpCode;
      window.verifyOtpAndCheckout = verifyOtpAndCheckout;
    </script>
  </body>
</html>