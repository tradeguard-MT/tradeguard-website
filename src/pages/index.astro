              href="https://dl.gettradeguard.app/TradeGuard_Setup_v1.1.0.exe" 
              class="bg-sky-500 hover:bg-sky-600 active:scale-95 text-white font-bold px-6 py-3.5 rounded-xl shadow-lg transition duration-150 flex items-center gap-2 whitespace-nowrap" 
              target="_blank" 
              rel="noopener noreferrer"
